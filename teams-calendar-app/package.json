{
  "name": "teams-calendar-app",
  "version": "1.0.0",
  "private": true,
  "description": "Local Teams notification calendar for Windows",
  "main": "main.js",
  "scripts": {
    "restore": "winapp restore",
    "generate": "winapp node generate-bindings",
    "start": "node main.js",
    "prepare-local": "powershell -ExecutionPolicy Bypass -File ./prepare-local.ps1"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@microsoft/dynwinrt": "0.1.0-preview.23" },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "^0.1.0-preview.23",
    "@microsoft/winappcli": "^0.7.1"
  },
  "imports": {
    "#winapp/bindings": {
      "types": "./.winapp/bindings/index.d.ts",
      "import": "./.winapp/bindings/index.mjs",
      "require": "./.winapp/bindings/index.js",
      "default": "./.winapp/bindings/index.js"
    },
    "#winapp/bindings/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "winapp": {
    "jsBindings": {
      "additionalWinmds": [
        { "namespace": "Windows.Foundation", "classes": ["PropertyValue"] },
        { "namespace": "Microsoft.UI.Windowing", "classes": ["AppWindow"] },
        { "namespace": "Microsoft.UI.Xaml", "classes": ["Application", "Window"] },
        { "namespace": "Microsoft.UI.Xaml.Controls", "classes": ["Button", "Grid", "ScrollViewer", "StackPanel", "TextBlock"] },
        { "namespace": "Windows.UI.Notifications.Management", "classes": ["UserNotificationListener"] }
      ],
      "additionalRefs": []
    }
  }
}
